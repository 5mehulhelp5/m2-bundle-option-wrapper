use Infrangible\BundleOptionWrapper\Catalog\Product\View\Type\Bundle\Option;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Option $block */

$optionId = $block->getBundleOptionId();
$classes = array_map(
    fn(string $class): string => $escaper->escapeHtmlAttr($class),
    $block->getWrapperClasses()
);
?>
<div id="bundle-option-<?= /* @noEscape */ $optionId ?>" data-option-id="<?= /* @noEscape */ $optionId ?>"
     class="<?= /* @noEscape */ implode(' ', $classes) ?>">
    <?= /* @noEscape */ $block->getBundleOptionHtml() ?>
</div>
